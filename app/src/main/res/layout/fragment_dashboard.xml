<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- Consistent content width -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="28dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="28dp" />


    <!-- Blue header background (behind greeting/balance/income-expense) -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dashboard_header_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/cardIncomeExpense" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDashboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:title=""
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile icon (top-left) -->
    <ImageButton android:id="@+id/btnProfileTop"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dash_profile"
        android:src="@drawable/ic_circle_profile"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintBottom_toBottomOf="@id/toolbarDashboard" />
    <!-- Greeting (left) -->
    <TextView android:id="@+id/tvGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dash_hello_there"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@id/btnProfileTop"
        app:layout_constraintEnd_toStartOf="@id/btnNotifications"
        app:layout_constraintBottom_toBottomOf="@id/toolbarDashboard"
        android:layout_marginBottom="4dp" />

    <!-- Notification Bell -->
    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dash_notifications"
        android:src="@drawable/ic_notifications"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toStartOf="@id/btnHamburger"
        app:layout_constraintBottom_toBottomOf="@id/toolbarDashboard" />

    <!-- Hamburger Icon (new) -->
    <ImageButton android:id="@+id/btnHamburger"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dash_hamburger_menu"
        android:src="@drawable/ic_ham_menu"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
        app:layout_constraintBottom_toBottomOf="@id/toolbarDashboard" />

    <!-- Total Balance (transparent card, text only) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTotalBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDashboard"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvTotalBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="34sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_gravity="center" />


            <TextView
                android:id="@+id/tvTotalBalanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.85"
                android:text="@string/dash_total_balance"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Income & Expense (merged in one white card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIncomeExpense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/cardTotalBalance"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:weightSum="2">

            <!-- Income column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="20dp">

                <TextView
                    android:id="@+id/tvIncomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Income"
                    android:textColor="@color/dark_gray"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvIncomeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/income_green"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="₱18,000.00" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="14dp"
                android:background="#E6E6E6" />

            <!-- Expense column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="20dp">

                <TextView
                    android:id="@+id/tvExpenseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expense"
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView android:id="@+id/tvExpenseAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/expense_red"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="₱5,500.00" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Stats (pure transparent container) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuickStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardCornerRadius="10dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardIncomeExpense"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

        <!-- Make Quick Stats vertical (stacked sections) -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:paddingStart="25dp"
            android:paddingEnd="25dp">

                <!-- ======================= 1) Expense Breakdown (FULL WIDTH) ======================= -->
                <LinearLayout android:id="@+id/layoutExpenseBreakdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/tvExpenseBreakdownLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Expense Breakdown" android:textColor="@color/dark_gray" android:textSize="14sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <!-- Donut chart container (wider, shorter) -->
                        <FrameLayout android:id="@+id/containerExpenseDonut" android:layout_width="160dp" android:layout_height="70dp" android:background="@color/light_gray" />
                        <!-- Legend (aligned to left, no center alignment) -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <!-- ===== Row 1 (Food) ===== -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="1dp" android:gravity="start">
                                <View android:id="@+id/dotExp1" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/expense_red" />
                                <TextView android:id="@+id/tvExpCat1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Food" android:textColor="@color/dark_gray" android:textSize="12sp" android:layout_gravity="start" />
                                <TextView android:id="@+id/tvExpPct1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="32%" android:textColor="@color/dark_gray" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_gravity="end" />
                            </LinearLayout>
                            <!-- ===== Row 2 (Transport) ===== -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="1dp" android:gravity="start">
                                <View android:id="@+id/dotExp2" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/primary" />
                                <TextView android:id="@+id/tvExpCat2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Transport" android:textColor="@color/dark_gray" android:textSize="12sp" android:layout_gravity="start" />
                                <TextView android:id="@+id/tvExpPct2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="18%" android:textColor="@color/dark_gray" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_gravity="end" />
                            </LinearLayout>
                            <!-- ===== Row 3 (Bills) ===== -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="1dp" android:gravity="start">
                                <View android:id="@+id/dotExp3" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/income_green" />
                                <TextView android:id="@+id/tvExpCat3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Bills" android:textColor="@color/dark_gray" android:textSize="12sp" android:layout_gravity="start" />
                                <TextView android:id="@+id/tvExpPct3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="14%" android:textColor="@color/dark_gray" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_gravity="end" />
                            </LinearLayout>
                            <!-- ===== Row 4 (Others) ===== -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="1dp" android:gravity="start">
                                <View android:id="@+id/dotExp4" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/dark_gray" />
                                <TextView android:id="@+id/tvExpCat4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Others" android:textColor="@color/dark_gray" android:textSize="12sp" android:layout_gravity="start" />
                                <TextView android:id="@+id/tvExpPct4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="36%" android:textColor="@color/dark_gray" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_gravity="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ======================= Divider between Expense and Budget ======================= -->

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:background="#E0E0E0" />
            <!-- Budget Health Section -->
            <LinearLayout android:id="@+id/layoutBudgetHealth" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" >
                <!-- Title and Percentage -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start|center_vertical">
                    <TextView android:id="@+id/tvBudgetHealthLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budget Health" android:textSize="14sp" android:textColor="@android:color/black" android:fontFamily="sans-serif-medium"/>
                    <TextView android:id="@+id/tvBudgetHealthPercentage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="0%" android:textSize="14sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <!-- Progress Bar -->
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="8dp">
                    <!-- Used Portion -->
                    <View android:id="@+id/barUsed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="@color/primary"/>
                    <!-- Remaining Portion -->
                    <View android:id="@+id/barRemaining" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="@color/primary_light"/>
                    <!-- Over Spending (if any) -->
                    <View android:id="@+id/barOver" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="@color/expense_red"/>
                </LinearLayout>
                <!-- Amount used vs Total Budget -->
                <TextView android:id="@+id/tvBudgetAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0 / ₱0" android:textSize="13sp" android:textColor="@android:color/black" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <!-- ======================= Divider between Budget and Debt/Loan ======================= -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="#E0E0E0" />
            <!-- ======================= 3) Debt & Loan (FULL WIDTH) ======================= -->
            <LinearLayout android:id="@+id/layoutDebtLoan" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvDebtLoanLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="Debt &amp; Loan" android:textColor="@color/dark_gray" android:textSize="14sp" />
                <!-- Row: Next Due -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:id="@+id/tvDebtNextDueLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Next Due" android:textColor="@color/dark_gray" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDebtNextDueValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="₱250 • 2 days" android:textColor="@color/dark_gray" android:textSize="13sp" tools:text="₱250 • 2 days" />
                </LinearLayout>
                <!-- Row: Active -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                    <TextView android:id="@+id/tvDebtActiveLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Active" android:textColor="@color/dark_gray" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDebtActiveValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="2" android:textColor="@color/dark_gray" android:textSize="13sp" tools:text="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Recent Transactions Header -->
    <LinearLayout android:id="@+id/layoutRecentHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" app:layout_constraintTop_toBottomOf="@id/cardQuickStats" app:layout_constraintStart_toStartOf="@id/guidelineStart" app:layout_constraintEnd_toEndOf="@id/guidelineEnd">
        <TextView android:id="@+id/tvRecentTransactions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent Transactions" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/dark_gray" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSeeAllTransactions" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" />
    </LinearLayout>
    <!-- Recent Transactions List -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvTransactions" android:layout_height="0dp" android:layout_width="0dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="12dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" app:layout_constraintTop_toBottomOf="@id/layoutRecentHeader" app:layout_constraintStart_toStartOf="@id/guidelineStart" app:layout_constraintEnd_toEndOf="@id/guidelineEnd" app:layout_constraintBottom_toBottomOf="parent" tools:listitem="@layout/item_transaction_compact" />
</androidx.constraintlayout.widget.ConstraintLayout>



